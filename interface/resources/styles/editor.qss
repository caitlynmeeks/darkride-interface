/* Build mode: the panels docked around the viewport. A dark editor theme, close to the
   Unity dark skin, scoped by object name so nothing else in the window is restyled. */

#EditorHierarchy, #EditorInspector {
    background: #383838;
    color: #d2d2d2;
    font-size: 12px;
}
#EditorHierarchy QWidget, #EditorInspector QWidget {
    background: #383838;
    color: #d2d2d2;
    font-size: 12px;
}
QDockWidget#EditorHierarchy::title, QDockWidget#EditorInspector::title {
    background: #3c3c3c;
    color: #d2d2d2;
    padding: 5px 8px;
    text-align: left;
    border-bottom: 1px solid #232323;
}

/* search field */
#EditorHierarchy QLineEdit {
    background: #2a2a2a;
    border: 1px solid #1f1f1f;
    border-radius: 3px;
    padding: 3px 6px;
    selection-background-color: #2c5d87;
}
#EditorHierarchy QLineEdit:focus {
    border-color: #2c5d87;
}

/* the entity tree */
#EditorHierarchy QTreeView {
    background: #383838;
    border: none;
    outline: 0;
    show-decoration-selected: 1;
}
#EditorHierarchy QTreeView::item {
    height: 20px;
    padding-left: 2px;
}
#EditorHierarchy QTreeView::item:hover {
    background: #404040;
}
#EditorHierarchy QTreeView::item:selected {
    background: #2c5d87;
    color: #ffffff;
}
/* styling the branch area at all replaces Qt's expander arrows, so they are drawn here: a parent's children were
   there but unseen, with nothing to open them by. Only Qt's own pseudo-states may be named: an unknown one makes
   the rule match every branch cell, arrows on everything */
#EditorHierarchy QTreeView::branch {
    background: #383838;
}
#EditorHierarchy QTreeView::branch:selected {
    background: #2c5d87;
}
#EditorHierarchy QTreeView::branch:has-children:closed {
    border-image: none;
    image: url(:/styles/branch-closed.svg);
}
#EditorHierarchy QTreeView::branch:has-children:open {
    border-image: none;
    image: url(:/styles/branch-open.svg);
}

/* inspector */
#EditorInspector QScrollArea {
    border: none;
}
#EditorInspector QLabel#EditorInspectorEmpty {
    color: #8f8f8f;
}
#EditorInspector QLabel#EditorInspectorTitle {
    font-size: 13px;
    font-weight: bold;
    padding: 4px 2px 6px 2px;
}
#EditorInspector QToolButton#EditorInspectorHeader {
    background: #3c3c3c;
    color: #d2d2d2;
    font-weight: bold;
    text-align: left;
    border: none;
    border-top: 1px solid #2b2b2b;
    padding: 4px 6px;
}
#EditorInspector QToolButton#EditorInspectorHeader:hover {
    background: #454545;
}
#EditorInspector #EditorInspectorMinorSection QToolButton#EditorInspectorHeader {
    background: #383838;
    font-weight: normal;
    color: #b8b8b8;
    padding-left: 14px;
}
#EditorInspector QLabel#EditorInspectorLabel {
    color: #c4c4c4;
}
#EditorInspector QLabel#EditorComponentLabel {
    color: #9a9a9a;
    padding-right: 1px;
}
#EditorInspector QDoubleSpinBox, #EditorInspector QLineEdit, #EditorInspector QComboBox, #EditorInspector QPlainTextEdit {
    background: #2a2a2a;
    border: 1px solid #1f1f1f;
    border-radius: 3px;
    padding: 2px 4px;
    selection-background-color: #2c5d87;
    min-height: 18px;
}
#EditorInspector QDoubleSpinBox:focus, #EditorInspector QLineEdit:focus, #EditorInspector QPlainTextEdit:focus {
    border-color: #2c5d87;
}
#EditorInspector QComboBox::drop-down {
    border: none;
    border-left: 1px solid #1f1f1f;
    width: 16px;
}
/* a chevron, as a dropdown is known by: the style's own arrow was lost on the dark field */
#EditorInspector QComboBox::down-arrow {
    image: url(:/styles/down.svg);
    width: 9px;
    height: 6px;
}
#EditorInspector QComboBox QAbstractItemView {
    background: #2a2a2a;
    selection-background-color: #2c5d87;
}
#EditorInspector QToolButton {
    background: #2a2a2a;
    border: 1px solid #1f1f1f;
    border-radius: 3px;
    padding: 2px 6px;
}
/* + Add and the layer list's + open a menu: their text says so, without Qt's arrow drawn over it */
#EditorInspector QToolButton#EditorUserDataAdd::menu-indicator, #EditorInspector QToolButton#EditorTerrainLayerAdd::menu-indicator {
    image: none;
    width: 0;
}
/* the Inspector's push buttons (a script's Edit and Reload, an impostor's Bake and Remove): the Build toolbar's button,
   as the Code and Make panels' (qml/darkride/editor/BuildButton.qml; mary's MAKE-POLISH.png, 11-08): a #505050 fill, a
   1 px #232323 edge, 3 px corners, no bevel; 23 px tall, at least 64 px wide */
#EditorInspector QPushButton {
    background: #505050;
    color: #d2d2d2;
    font-size: 12px;
    border: 1px solid #232323;
    border-radius: 3px;
    padding: 3px 9px;
    min-width: 44px;
}
#EditorInspector QPushButton:hover {
    background: #5a5a5a;
}
#EditorInspector QPushButton:pressed {
    background: #2c5d87;
}
#EditorInspector QPushButton:focus {
    border-color: #2c5d87;
}
#EditorInspector QPushButton:disabled {
    background: #424242;
    border-color: #2b2b2b;
    color: #6a6a6a;
}
#EditorInspector QCheckBox {
    spacing: 6px;
}
/* a Range's slider, as Unity draws one: a thin groove and a small round handle */
#EditorInspector QSlider {
    min-height: 18px;
}
#EditorInspector QSlider::groove:horizontal {
    height: 3px;
    background: #2a2a2a;
    border: 1px solid #1f1f1f;
    border-radius: 2px;
}
#EditorInspector QSlider::handle:horizontal {
    background: #9a9a9a;
    border: 1px solid #1f1f1f;
    width: 10px;
    margin: -4px 0;
    border-radius: 6px;
}
#EditorInspector QSlider::handle:horizontal:hover {
    background: #c4c4c4;
}
#EditorInspector QSlider::handle:horizontal:disabled {
    background: #555555;
}
/* an entity whose model, image or texture failed to load: its name red, the reasons under it (setLoadProblem) */
#EditorInspector QLabel#EditorInspectorTitle[loadFailed="true"] {
    color: #ff6b6b;
}
#EditorInspector QLabel#EditorInspectorLoadProblem {
    color: #ff6b6b;
    padding: 2px 2px 4px 2px;
}
/* Script and Server Script: what the script is doing now (ScriptEditor), grey, red when it failed */
#EditorInspector QLabel#EditorScriptStatus {
    color: #8f8f8f;
}
#EditorInspector QLabel#EditorScriptStatus[state="error"] {
    color: #ff6b6b;
}
#EditorInspector QLabel#EditorInspectorNote {
    color: #8f8f8f;
}
/* the header (Unity's): Visible and the name, the ticks under them, and why everything is greyed when it's locked */
#EditorInspector QLabel#EditorInspectorLockNote {
    color: #8f8f8f;
    font-size: 11px;
    padding: 0 2px 2px 2px;
}
#EditorInspector QLabel#EditorImageThumbnail {
    background: #2a2a2a;
    border: 1px solid #1f1f1f;
    border-radius: 3px;
    color: #8f8f8f;
}

/* User Data: its entries, folding as the Hierarchy's tree does */
#EditorInspector QTreeWidget#EditorUserData {
    background: #383838;
    border: 1px solid #2b2b2b;
    border-radius: 3px;
    outline: 0;
}
#EditorInspector QTreeWidget#EditorUserData::item {
    min-height: 24px;
    padding-left: 2px;
}
#EditorInspector QTreeWidget#EditorUserData::branch {
    background: #383838;
}
#EditorInspector QTreeWidget#EditorUserData::branch:has-children:closed {
    border-image: none;
    image: url(:/styles/branch-closed.svg);
}
#EditorInspector QTreeWidget#EditorUserData::branch:has-children:open {
    border-image: none;
    image: url(:/styles/branch-open.svg);
}

/* scroll bars */
#EditorHierarchy QScrollBar:vertical, #EditorInspector QScrollBar:vertical {
    background: #2f2f2f;
    width: 10px;
    margin: 0;
}
#EditorHierarchy QScrollBar::handle:vertical, #EditorInspector QScrollBar::handle:vertical {
    background: #5a5a5a;
    min-height: 24px;
    border-radius: 5px;
}
#EditorHierarchy QScrollBar::add-line:vertical, #EditorHierarchy QScrollBar::sub-line:vertical,
#EditorInspector QScrollBar::add-line:vertical, #EditorInspector QScrollBar::sub-line:vertical {
    height: 0;
}

/* the tool strip above the viewport */
QToolBar#EditorToolBar, QToolBar#EditorTerrainBar {
    background: #3c3c3c;
    border: none;
    border-bottom: 1px solid #232323;
    spacing: 2px;
    padding: 2px 6px;
}
QToolBar#EditorToolBar QToolButton, QToolBar#EditorTerrainBar QToolButton {
    background: transparent;
    color: #d2d2d2;
    font-size: 12px;
    border: 1px solid transparent;
    border-radius: 3px;
    padding: 3px 9px;
}
QToolBar#EditorToolBar QToolButton:hover, QToolBar#EditorTerrainBar QToolButton:hover {
    background: #474747;
}
QToolBar#EditorToolBar QToolButton:checked, QToolBar#EditorTerrainBar QToolButton:checked {
    background: #505050;
    border-color: #232323;
}
QToolBar#EditorToolBar QToolButton:pressed, QToolBar#EditorTerrainBar QToolButton:pressed {
    background: #2c5d87;
}
QToolBar#EditorToolBar::separator, QToolBar#EditorTerrainBar::separator {
    width: 1px;
    background: #232323;
    margin: 4px 6px;
}
/* Qt's overflow button, at the end of a strip too narrow for its tools. Our own picture: drawing the system's stops Qt 6 on
   macOS here. No padding or border: it's a small button */
QToolBar#EditorToolBar QToolButton#qt_toolbar_ext_button, QToolBar#EditorTerrainBar QToolButton#qt_toolbar_ext_button {
    qproperty-icon: url(:/styles/toolbar-overflow.svg);
    border: none;
    padding: 0;
}

/* the splitters between the panels and the viewport */
QMainWindow::separator {
    background: #232323;
    width: 4px;     /* as MainWindow's own (libraries/ui/src/MainWindow.cpp): wide enough to grab */
    height: 4px;
}
QMainWindow::separator:hover {
    background: #2c5d87;
}

/* the Create button and the status note on the build toolbar */
QToolBar#EditorToolBar QToolButton::menu-indicator, QToolBar#EditorTerrainBar QToolButton::menu-indicator {
    image: none;
    width: 0;
}

/* the status bar along the bottom: notes such as "Terrain saved" or an upload's progress, at the left */
QStatusBar#EditorStatusBar {
    background: #3c3c3c;
    border-top: 1px solid #232323;
    min-height: 20px;
}
QStatusBar#EditorStatusBar::item {
    border: none;
}
QStatusBar#EditorStatusBar QLabel#EditorStatus {
    color: #9a9a9a;
    font-size: 12px;
    padding: 0 6px;
}

/* a button that cannot be used now (Save World before World Edit is on) */
QToolBar#EditorToolBar QToolButton:disabled, QToolBar#EditorTerrainBar QToolButton:disabled {
    color: #6a6a6a;
}
/* World Edit while it is on: the world is being changed, which should be impossible to miss */
QToolBar#EditorToolBar QToolButton#EditorWorldEdit:checked {
    background: #c76a16;
    border-color: #7d430e;
    color: #ffffff;
}
QToolBar#EditorToolBar QToolButton#EditorWorldEdit:checked:hover {
    background: #d77b28;
}

/* read-only: a note at the top of both panels, dimmed names, greyed fields */
#EditorHierarchy QLabel#EditorReadOnlyBanner, #EditorInspector QLabel#EditorReadOnlyBanner {
    background: #4d3b1c;
    color: #f2dcae;
    padding: 5px 8px;
    border-bottom: 1px solid #232323;
}
#EditorHierarchy QTreeView[readOnly="true"] {
    color: #8a8a8a;
}
#EditorHierarchy QLabel#EditorHierarchyCounts {
    color: #9a9a9a;
    padding: 2px 4px;
}
#EditorHierarchy QToolButton#EditorHierarchyRefresh {
    color: #d0d0d0;
    background: #454545;
    border: 1px solid #2a2a2a;
    border-radius: 3px;
    padding: 1px 8px;
}
#EditorHierarchy QToolButton#EditorHierarchyRefresh:hover {
    background: #505050;
}
#EditorHierarchy QToolButton#EditorHierarchyRefresh:pressed {
    background: #2c5d87;
}
#EditorInspector QDoubleSpinBox:disabled, #EditorInspector QLineEdit:disabled, #EditorInspector QComboBox:disabled,
#EditorInspector QPlainTextEdit:disabled, #EditorInspector QToolButton:disabled {
    color: #7a7a7a;
    background: #323232;
}
#EditorInspector QCheckBox:disabled {
    color: #7a7a7a;
}

/* the Terrain tool's row: the brush's fields and the hint at its end */
QToolBar#EditorTerrainBar QLabel#EditorFieldName {
    color: #9a9a9a;
    font-size: 12px;
    padding: 0 3px 0 10px;
}
QToolBar#EditorTerrainBar QDoubleSpinBox, QToolBar#EditorTerrainBar QSpinBox {
    background: #2a2a2a;
    color: #d2d2d2;
    font-size: 12px;
    border: 1px solid #232323;
    border-radius: 3px;
    padding: 1px 4px;
    min-width: 58px;
}
QToolBar#EditorTerrainBar QDoubleSpinBox:focus, QToolBar#EditorTerrainBar QSpinBox:focus {
    border-color: #2c5d87;
}
QToolBar#EditorTerrainBar QLabel#EditorHint {
    color: #7a7a7a;
    font-size: 11px;
    padding: 0 8px 0 16px;
}

/* the Inspector's terrain layer list: rows are widgets (eye, swatch, name), which cover the list's own selection
   highlight, so the selected row is marked by a property set in TerrainLayersEditor::markSelectedRow */
#EditorTerrainLayerList::item {
    height: 26px;
}
#EditorTerrainLayerList::item:hover {
    background: #404040;
}
#EditorTerrainLayerList::item:selected {
    background: #2c5d87;
}
#EditorTerrainLayerRow[selected="true"] {
    background: #2c5d87;
    border-radius: 3px;
}
#EditorTerrainLayerRow[selected="true"] QLabel#EditorTerrainLayerName {
    color: #ffffff;
    font-weight: bold;
}
/* a picture dragged over a row (from the Assets panel): the layer that will take it as its texture */
#EditorTerrainLayerRow[dropTarget="true"] {
    background: #3a6f9c;
    border: 1px solid #8cc4f0;
    border-radius: 3px;
}

/* the Inspector's vehicle wheel and seat lists (VehiclePartsEditor), the same way */
#EditorVehicleList::item {
    height: 22px;
}
#EditorVehicleList::item:hover {
    background: #404040;
}
#EditorVehicleList::item:selected {
    background: #2c5d87;
}
#EditorVehicleRow[selected="true"] {
    background: #2c5d87;
    border-radius: 3px;
}
#EditorVehicleRow QLabel#EditorVehicleSummary {
    color: #8f8f8f;
}
#EditorVehicleRow[selected="true"] QLabel#EditorVehicleName {
    color: #ffffff;
    font-weight: bold;
}
#EditorVehicleRow[selected="true"] QLabel#EditorVehicleSummary {
    color: #d0e0ee;
}

/* the Assets panel along the bottom: My Files as a folder tree beside a grid of the folder's contents */
#EditorAssets {
    background: #383838;
    color: #d2d2d2;
    font-size: 12px;
}
#EditorAssets QWidget {
    background: #383838;
    color: #d2d2d2;
    font-size: 12px;
}
QDockWidget#EditorAssets::title {
    background: #3c3c3c;
    color: #d2d2d2;
    padding: 5px 8px;
    text-align: left;
    border-bottom: 1px solid #232323;
}
#EditorAssets QLineEdit, #EditorAssets QComboBox {
    background: #2a2a2a;
    border: 1px solid #1f1f1f;
    border-radius: 3px;
    padding: 2px 6px;
    selection-background-color: #2c5d87;
    min-height: 18px;
}
#EditorAssets QLineEdit:focus {
    border-color: #2c5d87;
}
#EditorAssets QComboBox::drop-down {
    border: none;
    border-left: 1px solid #1f1f1f;
    width: 16px;
}
#EditorAssets QComboBox::down-arrow {
    image: url(:/styles/down.svg);
    width: 9px;
    height: 6px;
}
#EditorAssets QComboBox QAbstractItemView {
    background: #2a2a2a;
    selection-background-color: #2c5d87;
}
#EditorAssets QToolButton {
    background: #2a2a2a;
    border: 1px solid #1f1f1f;
    border-radius: 3px;
    padding: 2px 8px;
    min-height: 18px;
}
#EditorAssets QToolButton:hover {
    background: #474747;
}
#EditorAssets QToolButton:pressed {
    background: #2c5d87;
}
/* the view buttons: Icons, Details; the chosen one stays lit */
#EditorAssets QToolButton#EditorAssetsView {
    padding: 2px 4px;
}
#EditorAssets QToolButton#EditorAssetsView:checked {
    background: #2c5d87;
}
/* where you are: My Files › images › trees */
#EditorAssets QToolButton#EditorAssetsCrumb {
    background: transparent;
    border: 1px solid transparent;
    color: #b8b8b8;
    padding: 2px 4px;
}
#EditorAssets QToolButton#EditorAssetsCrumb:hover {
    background: #474747;
}
#EditorAssets QToolButton#EditorAssetsCrumb[last="true"] {
    color: #f0f0f0;   /* the skin's text under a skin (Editor::applyStyle): it sits on the panel, not on the selection */
    font-weight: bold;
}
#EditorAssets QLabel#EditorAssetsCrumbSeparator {
    color: #7a7a7a;
    padding: 0 1px;
}
#EditorAssets QLabel#EditorAssetsQuota {
    color: #8f8f8f;
    padding: 0 4px 0 8px;
}
#EditorAssets QLabel#EditorAssetsEmpty {
    color: #7a7a7a;
    background: transparent;
}
#EditorAssets QLabel#EditorAssetsNote { color: #b8b8b8; font-size: 11px; padding: 0 4px; }
#EditorAssets QLabel#EditorRightsLine {
    color: #8f8f8f;
    font-size: 11px;
    padding: 0 4px;
}
#EditorAssets QLabel#EditorReadOnlyBanner {
    background: #4d3b1c;
    color: #f2dcae;
    padding: 5px 8px;
    border-bottom: 1px solid #232323;
}
#EditorAssets QSplitter::handle {
    background: #2b2b2b;
    width: 3px;
}
/* the folder tree, as the Hierarchy's */
#EditorAssets QTreeView {
    background: #383838;
    border: none;
    outline: 0;
    show-decoration-selected: 1;
}
#EditorAssets QTreeView::item {
    height: 20px;
    padding-left: 2px;
}
#EditorAssets QTreeView::item:hover {
    background: #404040;
}
#EditorAssets QTreeView::item:selected {
    background: #2c5d87;
    color: #ffffff;
}
#EditorAssets QTreeView::branch {
    background: #383838;
}
#EditorAssets QTreeView::branch:selected {
    background: #2c5d87;
}
#EditorAssets QTreeView::branch:has-children:closed {
    border-image: none;
    image: url(:/styles/branch-closed.svg);
}
#EditorAssets QTreeView::branch:has-children:open {
    border-image: none;
    image: url(:/styles/branch-open.svg);
}
/* the Details view's header: the columns, clicked to sort */
#EditorAssets QHeaderView {
    background: #2f2f2f;
    border: none;
}
#EditorAssets QHeaderView::section {
    background: #2f2f2f;
    color: #b8b8b8;
    border: none;
    border-right: 1px solid #262626;
    border-bottom: 1px solid #262626;
    padding: 3px 6px;
}
#EditorAssets QHeaderView::section:hover {
    background: #3a3a3a;
}
#EditorAssets QHeaderView::up-arrow {
    image: url(:/styles/up.svg);
    width: 9px;
    height: 6px;
    subcontrol-position: center right;
    subcontrol-origin: padding;
    margin-right: 2px;
}
#EditorAssets QHeaderView::down-arrow {
    image: url(:/styles/down.svg);
    width: 9px;
    height: 6px;
    subcontrol-position: center right;
    subcontrol-origin: padding;
    margin-right: 2px;
}
/* the grid: an icon with its name under it */
#EditorAssets QListView {
    background: #383838;
    border: none;
    outline: 0;
}
#EditorAssets QListView::item {
    border-radius: 3px;
    padding: 2px;
}
#EditorAssets QListView::item:hover {
    background: #404040;
}
#EditorAssets QListView::item:selected {
    background: #2c5d87;
    color: #ffffff;
}
#EditorAssets QScrollBar:vertical {
    background: #2f2f2f;
    width: 10px;
    margin: 0;
}
#EditorAssets QScrollBar::handle:vertical {
    background: #5a5a5a;
    min-height: 24px;
    border-radius: 5px;
}
#EditorAssets QScrollBar::add-line:vertical, #EditorAssets QScrollBar::sub-line:vertical {
    height: 0;
}
#EditorAssets QScrollBar:horizontal {
    background: #2f2f2f;
    height: 10px;
    margin: 0;
}
#EditorAssets QScrollBar::handle:horizontal {
    background: #5a5a5a;
    min-width: 24px;
    border-radius: 5px;
}
#EditorAssets QScrollBar::add-line:horizontal, #EditorAssets QScrollBar::sub-line:horizontal {
    width: 0;
}
