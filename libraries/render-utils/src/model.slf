<@include graphics/Material.slh@>
<@include graphics/MaterialTextures.slh@>
<@include render-utils/ShaderConstants.h@>
<@include CullFace.slh@>

<@if not HIFI_USE_SHADOW@>
    <@if HIFI_USE_FORWARD or HIFI_USE_TRANSLUCENT@>
        <@include DefaultMaterials.slh@>
        <@include GlobalLight.slh@>
        <@if HIFI_USE_FORWARD@>
            <@if not HIFI_USE_UNLIT@>
                // the forward path lights in place: the sun's shadow cascades, and the point and spot lights of the
                // fragment's cluster with their shadows and cookies (the pass binds them for every lit pipeline)
                <@include Shadow.slh@>
                <@include LightLocal.slh@>
            <@endif@>
        <@endif@>
        <@if HIFI_USE_TRANSLUCENT@>
            <@if not HIFI_USE_FORWARD@>
                <@include LightLocal.slh@>
            <@endif@>
        <@endif@>
        <@if HIFI_USE_LIGHTMAP@>
            // a lightmap lights in one of two modes (LIGHTMAPS.md, the material's LIGHTMAP_FULL_BIT): the full bake
            // of old, or the baked light in place of the ambient diffuse term with everything else lit as usual
            <$declareEvalLightmappedColor()$>
        <@endif@>
        <@if HIFI_USE_TRANSLUCENT@>
            <$declareEvalGlobalLightingAlphaBlended()$>
        <@else@>
            <$declareEvalSkyboxGlobalColor(_SCRIBE_NULL, HIFI_USE_FORWARD)$>
        <@endif@>
        <@include gpu/Transform.slh@>
        <$declareStandardCameraTransform()$>
        layout(location=0) out vec4 _fragColor0;
    <@else@>
        <@include DeferredBufferWrite.slh@>
    <@endif@>
<@else@>
    layout(location=0) out vec4 _fragColor0;
<@endif@>

<@if HIFI_USE_UNLIT@>
    <@include LightingModel.slh@>
<@endif@>

<@if HIFI_USE_SHADOW or HIFI_USE_UNLIT@>
    <$declareMaterialTextures(ALBEDO)$>
<@else@>
    <@if not HIFI_USE_LIGHTMAP@>
        <@if HIFI_USE_NORMALMAP and HIFI_USE_TRANSLUCENT@>
            <$declareMaterialTextures(ALBEDO, ROUGHNESS, NORMAL , METALLIC, EMISSIVE, OCCLUSION)$>
        <@elif HIFI_USE_NORMALMAP@>
            <$declareMaterialTextures(ALBEDO, ROUGHNESS, NORMAL , METALLIC, EMISSIVE, OCCLUSION, SCATTERING)$>
        <@elif HIFI_USE_TRANSLUCENT@>
            <$declareMaterialTextures(ALBEDO, ROUGHNESS, _SCRIBE_NULL , METALLIC, EMISSIVE, OCCLUSION)$>
        <@else@>
            <$declareMaterialTextures(ALBEDO, ROUGHNESS, _SCRIBE_NULL , METALLIC, EMISSIVE, OCCLUSION, SCATTERING)$>
        <@endif@>
    <@else@>
        <@if HIFI_USE_NORMALMAP@>
            <$declareMaterialTextures(ALBEDO, ROUGHNESS, NORMAL, METALLIC, EMISSIVE, OCCLUSION)$>
        <@else@>
            <$declareMaterialTextures(ALBEDO, ROUGHNESS, _SCRIBE_NULL, METALLIC, EMISSIVE, OCCLUSION)$>
        <@endif@>
        <$declareMaterialLightmap()$>
    <@endif@>
<@endif@>

<@if HIFI_USE_FADE@>
    <@include Fade.slh@>
    <$declareFadeFragment()$>
<@endif@>

layout(location=RENDER_UTILS_ATTR_POSITION_WS) in vec4 _positionWS;
layout(location=RENDER_UTILS_ATTR_TEXCOORD01) in vec4 _texCoord01;
#define _texCoord0 _texCoord01.xy
#define _texCoord1 _texCoord01.zw
<@if not HIFI_USE_SHADOW@>
    layout(location=RENDER_UTILS_ATTR_POSITION_ES) in vec4 _positionES;
    layout(location=RENDER_UTILS_ATTR_NORMAL_WS) in vec3 _normalWS;
    layout(location=RENDER_UTILS_ATTR_COLOR) in vec4 _color;
    <@if HIFI_USE_NORMALMAP@>
        layout(location=RENDER_UTILS_ATTR_TANGENT_WS) in vec3 _tangentWS;
    <@endif@>
<@endif@>

void main(void) {
<@if HIFI_USE_FADE@>
    <@if not HIFI_USE_SHADOW@>
        vec3 fadeEmissive;
        FadeObjectParams fadeParams;
        <$fetchFadeObjectParams(fadeParams)$>
        applyFade(fadeParams, _positionWS.xyz, fadeEmissive);
    <@else@>
        FadeObjectParams fadeParams;
        <$fetchFadeObjectParams(fadeParams)$>
        applyFadeClip(fadeParams, _positionWS.xyz);
    <@endif@>
<@endif@>

    Material mat = getMaterial();
    BITFIELD matKey = getMaterialKey(mat);
<@if HIFI_USE_SHADOW or HIFI_USE_UNLIT@>
        <$fetchMaterialTexturesCoord0(matKey, _texCoord0, albedoTex)$>

    <@if HIFI_USE_TRANSLUCENT@>
        float cutoff = getMaterialOpacityCutoff(mat);
        float opacity = getMaterialOpacity(mat) * _color.a;
        <$evalMaterialOpacity(albedoTex.a, cutoff, opacity, matKey, opacity)$>;
        <$discardInvisible(opacity)$>;
    <@else@>
        float cutoff = getMaterialOpacityCutoff(mat);
        float opacity = 1.0;
        <$evalMaterialOpacityMask(albedoTex.a, cutoff, opacity, matKey, opacity)$>;
        <$discardTransparent(opacity)$>;
    <@endif@>

    <@if not HIFI_USE_SHADOW@>
            vec3 albedo = getMaterialAlbedo(mat);
            <$evalMaterialAlbedo(albedoTex, albedo, matKey, albedo)$>;
            albedo *= _color.rgb;
        <@if HIFI_USE_FADE@>
                albedo += fadeEmissive;
        <@endif@>
    <@endif@>

    <@if HIFI_USE_SHADOW@>
            _fragColor0 = vec4(1.0);
    <@elif HIFI_USE_TRANSLUCENT or HIFI_USE_FORWARD@>
            _fragColor0 = vec4(albedo * isUnlitEnabled(), opacity);
    <@else@>
            packDeferredFragmentUnlit(
                evalSafeFrontOrBackFaceNormal(_normalWS, _positionWS.xyz),
                opacity,
                albedo * isUnlitEnabled());
    <@endif@>
<@else@>
    <@if not HIFI_USE_LIGHTMAP@>
        <@if HIFI_USE_NORMALMAP and HIFI_USE_TRANSLUCENT@>
            <$fetchMaterialTexturesCoord0(matKey, _texCoord0, albedoTex, roughnessTex, normalTex, metallicTex, emissiveTex, _SCRIBE_NULL)$>
        <@elif HIFI_USE_NORMALMAP@>
            <$fetchMaterialTexturesCoord0(matKey, _texCoord0, albedoTex, roughnessTex, normalTex, metallicTex, emissiveTex, scatteringTex)$>
        <@elif HIFI_USE_TRANSLUCENT@>
            <$fetchMaterialTexturesCoord0(matKey, _texCoord0, albedoTex, roughnessTex, _SCRIBE_NULL, metallicTex, emissiveTex, _SCRIBE_NULL)$>
        <@else@>
            <$fetchMaterialTexturesCoord0(matKey, _texCoord0, albedoTex, roughnessTex, _SCRIBE_NULL, metallicTex, emissiveTex, scatteringTex)$>
        <@endif@>
            // a packed occlusion map shares the other maps' texture coordinates; one of its own has the lightmap's
            vec2 occlusionTexCoord = mix(_texCoord1, _texCoord0, float((matKey & OCCLUSION_TEXCOORD0_BIT) != 0));
            <$fetchMaterialTexturesCoord1(matKey, occlusionTexCoord, occlusionTex)$>
    <@else@>
        <@if HIFI_USE_NORMALMAP@>
            <$fetchMaterialTexturesCoord0(matKey, _texCoord0, albedoTex, roughnessTex, normalTex, metallicTex, emissiveTex, _SCRIBE_NULL)$>
        <@else@>
            <$fetchMaterialTexturesCoord0(matKey, _texCoord0, albedoTex, roughnessTex, _SCRIBE_NULL, metallicTex, emissiveTex, _SCRIBE_NULL)$>
        <@endif@>
            vec2 occlusionTexCoord = mix(_texCoord1, _texCoord0, float((matKey & OCCLUSION_TEXCOORD0_BIT) != 0));
            <$fetchMaterialTexturesCoord1(matKey, occlusionTexCoord, occlusionTex)$>
            <$fetchMaterialTexturesCoord1(matKey, _texCoord1, _SCRIBE_NULL, lightmap)$>
    <@endif@>

    <@if HIFI_USE_TRANSLUCENT@>
        float cutoff = getMaterialOpacityCutoff(mat);
        float opacity = getMaterialOpacity(mat) * _color.a;
        <$evalMaterialOpacity(albedoTex.a, cutoff, opacity, matKey, opacity)$>;
        <$discardInvisible(opacity)$>;
    <@else@>
        float cutoff = getMaterialOpacityCutoff(mat);
        float opacity = 1.0;
        <$evalMaterialOpacityMask(albedoTex.a, cutoff, opacity, matKey, opacity)$>;
        <$discardTransparent(opacity)$>;
    <@endif@>

        vec3 albedo = getMaterialAlbedo(mat);
        <$evalMaterialAlbedo(albedoTex, albedo, matKey, albedo)$>;
        albedo *= _color.rgb;

        float roughness = getMaterialRoughness(mat);
        <$evalMaterialRoughness(roughnessTex, roughness, matKey, roughness)$>;

        float metallic = getMaterialMetallic(mat);
        <$evalMaterialMetallic(metallicTex, metallic, matKey, metallic)$>;

        vec3 emissive = getMaterialEmissive(mat);
        <$evalMaterialEmissive(emissiveTex, emissive, matKey, emissive)$>;

        float occlusion = DEFAULT_OCCLUSION;
        <$evalMaterialOcclusion(occlusionTex, matKey, occlusion)$>;

    <@if not HIFI_USE_TRANSLUCENT@>
        <@if not HIFI_USE_LIGHTMAP@>
            float scattering = getMaterialScattering(mat);
            <$evalMaterialScattering(scatteringTex, scattering, matKey, scattering)$>;
        <@endif@>
    <@endif@>

    <@if HIFI_USE_NORMALMAP@>
            vec3 fragNormalWS;
            <$evalMaterialNormalLOD(_positionES, normalTex, _normalWS, _tangentWS, fragNormalWS)$>
    <@else@>
            vec3 fragNormalWS = _normalWS;
    <@endif@>
        fragNormalWS = evalSafeFrontOrBackFaceNormal(fragNormalWS, _positionWS.xyz,
                                                     (matKey & KEEP_BACK_FACE_NORMAL_BIT) != 0);
    <@if HIFI_USE_LIGHTMAP@>
        // the baked light's direction shades the normal-mapped normal (LIGHTMAPS.md §3.4)
        if ((matKey & LIGHTMAP_DIRECTION_MAP_BIT) != 0) {
            lightmap = applyLightMapDirection(lightmap, _texCoord1, fragNormalWS);
        }
    <@endif@>

    <@if HIFI_USE_FORWARD@>
        TransformCamera cam = getTransformCamera();
        vec3 fresnel = getFresnelF0(metallic, albedo);
        vec3 fragPositionWS = _positionWS.xyz;

        // the sun's shadow, from its cascades, when the frame has them (a count of 0 with shadows off, or none drawn)
        float shadowAttenuation = 1.0;
        if (getShadowCascadeCount() > 0) {
            shadowAttenuation = evalShadowAttenuation(getLightDirection(getKeyLight()), _positionWS, -_positionES.z, fragNormalWS);
        }
        // the point and spot lights of the cluster the fragment falls in, with their shadows and cookies, as the
        // deferred path's translucent pass takes them; the derivatives are for the cookies, taken here where
        // control flow is uniform
        vec3 fragPositionWSDx = dFdx(fragPositionWS);
        vec3 fragPositionWSDy = dFdy(fragPositionWS);
        vec3 fragToEyeDirWS = normalize(cam._viewInverse[3].xyz - fragPositionWS);
        SurfaceData surfaceWS = initSurfaceData(roughness, fragNormalWS, fragToEyeDirWS);

        vec4 localLighting = vec4(0.0);
        <$fetchClusterInfo(_positionWS)$>;
        if (hasLocalLights(cluster)) {
            localLighting = evalLocalLighting(cluster, fragPositionWS, fragPositionWSDx, fragPositionWSDy, surfaceWS,
                                              metallic, fresnel, albedo, 0.0,
                                              vec4(0), vec4(0), opacity);
        }
        <@if HIFI_USE_LIGHTMAP@>
            bool lightmapFull = (matKey & LIGHTMAP_FULL_BIT) != 0;
            vec3 lightmapDiffuse = evalLightmapDiffuse(lightmap, albedo, metallic, occlusion);
        <@endif@>
        <@if not HIFI_USE_TRANSLUCENT@>
            <@if not HIFI_USE_LIGHTMAP@>
                _fragColor0 = vec4(evalSkyboxGlobalColor(
                    cam._viewInverse,
                    shadowAttenuation,
                    occlusion,
                    _positionES.xyz,
                    albedo,
                    fresnel,
                    metallic,
                    emissive,
                    surfaceWS,
                    localLighting.rgb),
                    opacity);
            <@else@>
                if (lightmapFull) {
                    // the bake of old is the whole diffuse lighting; the local lights and the emissive over it
                    _fragColor0 = vec4(evalLightmappedColor(
                        cam._viewInverse,
                        shadowAttenuation,
                        occlusion,
                        fragNormalWS,
                        albedo,
                        lightmap) + localLighting.rgb + emissive * isEmissiveEnabled(),
                        opacity);
                } else {
                    _fragColor0 = vec4(evalSkyboxGlobalColorLightmapped(
                        cam._viewInverse,
                        shadowAttenuation,
                        occlusion,
                        _positionES.xyz,
                        albedo,
                        fresnel,
                        metallic,
                        emissive,
                        surfaceWS,
                        localLighting.rgb,
                        lightmapDiffuse),
                        opacity);
                }
            <@endif@>
        <@else@>
            <@if not HIFI_USE_LIGHTMAP@>
                _fragColor0 =  vec4(evalGlobalLightingAlphaBlended(
                    cam._viewInverse,
                    shadowAttenuation,
                    occlusion,
                    _positionES.xyz,
                    fragNormalWS,
                    albedo,
                    fresnel,
                    metallic,
                    emissive,
                    surfaceWS, opacity, localLighting.rgb),
                    opacity);
            <@else@>
                if (lightmapFull) {
                    _fragColor0 = vec4(evalLightmappedColor(
                        cam._viewInverse,
                        shadowAttenuation,
                        occlusion,
                        fragNormalWS,
                        albedo,
                        lightmap) + localLighting.rgb + emissive * isEmissiveEnabled(),
                        opacity);
                } else {
                    _fragColor0 = vec4(evalGlobalLightingAlphaBlendedLightmapped(
                        cam._viewInverse,
                        shadowAttenuation,
                        occlusion,
                        _positionES.xyz,
                        fragNormalWS,
                        albedo,
                        fresnel,
                        metallic,
                        emissive,
                        surfaceWS, opacity, localLighting.rgb,
                        lightmapDiffuse),
                        opacity);
                }
            <@endif@>
        <@endif@>
    <@else@>
        <@if not HIFI_USE_TRANSLUCENT@>
            <@if not HIFI_USE_LIGHTMAP@>
                packDeferredFragment(
                    fragNormalWS,
                    opacity,
                    albedo,
                    roughness,
                    metallic,
                    emissive
                <@if HIFI_USE_FADE@>
                        + fadeEmissive
                <@endif@>
                    ,
                    occlusion,
                    scattering);
            <@else@>
                if ((matKey & LIGHTMAP_FULL_BIT) != 0) {
                    packDeferredFragmentLightmap(
                        fragNormalWS,
                        evalOpaqueFinalAlpha(getMaterialOpacity(mat), opacity),
                        albedo,
                        roughness,
                        metallic,
                        lightmap,
                        emissive
                    <@if HIFI_USE_FADE@>
                            + fadeEmissive
                    <@endif@>
                        );
                } else {
                    packDeferredFragmentLightmapIndirect(
                        fragNormalWS,
                        evalOpaqueFinalAlpha(getMaterialOpacity(mat), opacity),
                        albedo,
                        roughness,
                        metallic,
                        emissive
                    <@if HIFI_USE_FADE@>
                            + fadeEmissive
                    <@endif@>
                        ,
                        occlusion,
                        evalLightmapDiffuse(lightmap, albedo, metallic, occlusion));
                }
            <@endif@>
        <@else@>
            TransformCamera cam = getTransformCamera();
            vec3 fresnel = getFresnelF0(metallic, albedo);

            vec3 fragPositionWS = _positionWS.xyz;
            // for spot lights' cookies, taken here: inside the branch below derivatives are undefined
            vec3 fragPositionWSDx = dFdx(fragPositionWS);
            vec3 fragPositionWSDy = dFdy(fragPositionWS);
            vec3 fragToEyeWS = cam._viewInverse[3].xyz - fragPositionWS;
            vec3 fragToEyeDirWS = normalize(fragToEyeWS);
            SurfaceData surfaceWS = initSurfaceData(roughness, fragNormalWS, fragToEyeDirWS);

            vec4 localLighting = vec4(0.0);
            <$fetchClusterInfo(_positionWS)$>;
            if (hasLocalLights(cluster)) {
                localLighting = evalLocalLighting(cluster, fragPositionWS, fragPositionWSDx, fragPositionWSDy, surfaceWS,
                                                  metallic, fresnel, albedo, 0.0,
                                                  vec4(0), vec4(0), opacity);
            }

            <@if not HIFI_USE_LIGHTMAP@>
                _fragColor0 = vec4(evalGlobalLightingAlphaBlended(
                    cam._viewInverse,
                    1.0,
                    occlusion,
                    _positionES.xyz,
                    fragNormalWS,
                    albedo,
                    fresnel,
                    metallic,
                    emissive
                <@if HIFI_USE_FADE@>
                        + fadeEmissive
                <@endif@>
                    ,
                    surfaceWS, opacity, localLighting.rgb),
                    opacity);
            <@else@>
                if ((matKey & LIGHTMAP_FULL_BIT) != 0) {
                    _fragColor0 = vec4(evalLightmappedColor(
                        cam._viewInverse,
                        1.0,
                        occlusion,
                        fragNormalWS,
                        albedo,
                        lightmap) + localLighting.rgb + emissive * isEmissiveEnabled()
                    <@if HIFI_USE_FADE@>
                            + fadeEmissive
                    <@endif@>
                        ,
                        opacity);
                } else {
                    _fragColor0 = vec4(evalGlobalLightingAlphaBlendedLightmapped(
                        cam._viewInverse,
                        1.0,
                        occlusion,
                        _positionES.xyz,
                        fragNormalWS,
                        albedo,
                        fresnel,
                        metallic,
                        emissive
                    <@if HIFI_USE_FADE@>
                            + fadeEmissive
                    <@endif@>
                        ,
                        surfaceWS, opacity, localLighting.rgb,
                        evalLightmapDiffuse(lightmap, albedo, metallic, occlusion)),
                        opacity);
                }
            <@endif@>
        <@endif@>
    <@endif@>
<@endif@>
}
