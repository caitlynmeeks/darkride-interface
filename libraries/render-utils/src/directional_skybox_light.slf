<@include DeferredBufferRead.slh@>
<@include render-utils/ShaderConstants.h@>

// the reflection probes' cube map array and the probe volume in the slots the deferred pass has free
// (ReflectionProbe.slh, LightAmbient.slh)
<@def REFLECTION_PROBES_DEFERRED@>
<@def PROBE_VOLUME_DEFERRED@>
<@include GlobalLight.slh@>
<@if HIFI_USE_AMBIENT@>
    <$declareEvalAmbientSphereGlobalColor(supportScattering)$>
<@else@>
    <$declareEvalSkyboxGlobalColor(supportScattering, _SCRIBE_NULL)$>
<@endif@>
<@include ToonLight.slh@>
<$declareEvalToonGlobalColor(supportScattering)$>

<@if HIFI_USE_SHADOW@>
    <@include Shadow.slh@>
<@endif@>

layout(location=RENDER_UTILS_ATTR_TEXCOORD01) in vec4 _texCoord01;
#define _texCoord0 _texCoord01.xy
#define _texCoord1 _texCoord01.zw

layout(location=0) out vec4 _fragColor;

void main(void) {
    DeferredFrameTransform deferredTransform = getDeferredFrameTransform();
    DeferredFragment frag = unpackDeferredFragment(deferredTransform, _texCoord0);

<@if HIFI_USE_SHADOW@>
    vec4 viewPos = vec4(frag.position.xyz, 1.0);
    vec4 worldPos = getViewInverse() * viewPos;
    Light shadowLight = getKeyLight();
    vec3 worldLightDirection = getLightDirection(shadowLight);
    float shadowAttenuation = evalShadowAttenuation(worldLightDirection, worldPos, -viewPos.z, frag.normal);
<@else@>
    float shadowAttenuation = 1.0;
<@endif@>

    if (frag.mode == FRAG_MODE_UNLIT || frag.mode == FRAG_MODE_LIGHTMAPPED) {
        discard;
    } else if (frag.mode == FRAG_MODE_TOON) {
        // MToon's default GI equalization: the G-buffer has no room for the material's
        const float TOON_GI_EQUALIZATION = 0.9;
        _fragColor = vec4(evalToonGlobalColor(getViewInverse(), shadowAttenuation, frag.obscurance, frag.position.xyz,
                                              frag.normal, frag.albedo, frag.toonShadeColor, frag.toonShadingShift,
                                              frag.toonShadingToony, TOON_GI_EQUALIZATION), 1.0);
    } else {
        vec4 midNormalCurvature = vec4(0);
        vec4 lowNormalCurvature = vec4(0);
        unpackMidLowNormalCurvature(_texCoord0, midNormalCurvature, lowNormalCurvature);
        float check = float(frag.mode == FRAG_MODE_SCATTERING);
        midNormalCurvature = check * midNormalCurvature;
        lowNormalCurvature = check * lowNormalCurvature;

        vec3 color;
        if (frag.mode == FRAG_MODE_LIGHTMAPPED_INDIRECT) {
            // the baked diffuse light is in the lighting buffer already (packDeferredFragmentLightmapIndirect): no
            // ambient diffuse here, the rest as for any shaded fragment (LIGHTMAPS.md)
<@if HIFI_USE_AMBIENT@>
            color = evalAmbientSphereGlobalColorLightmapped(
<@else@>
            color = evalSkyboxGlobalColorLightmapped(
<@endif@>
                        getViewInverse(),
                        shadowAttenuation,
                        frag.obscurance,
                        frag.position.xyz,
                        frag.normal,
                        frag.albedo,
                        frag.fresnel,
                        frag.metallic,
                        frag.roughness,
                        frag.scattering,
                        midNormalCurvature,
                        lowNormalCurvature,
                        vec3(0.0));
        } else {
<@if HIFI_USE_AMBIENT@>
            color = evalAmbientSphereGlobalColor(
<@else@>
            color = evalSkyboxGlobalColor(
<@endif@>
                        getViewInverse(),
                        shadowAttenuation,
                        frag.obscurance,
                        frag.position.xyz,
                        frag.normal,
                        frag.albedo,
                        frag.fresnel,
                        frag.metallic,
                        frag.roughness,
                        frag.scattering,
                        midNormalCurvature,
                        lowNormalCurvature);
        }

        _fragColor = vec4(color, 1.0);
    }
}
